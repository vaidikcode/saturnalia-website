# Copy to `.env.local` for LOCAL development only.
# Auth mode: Clerk Account Portal (hosted sign-in on *.accounts.dev).
# Full setup: docs/dashboard-setup.md

# --- Clerk Development (API Keys page) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# After Account Portal login, land here (optional; also set on ClerkProvider)
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/account
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/account

# --- Convex Development (usually written by `bunx convex dev`) ---
NEXT_PUBLIC_CONVEX_URL=

# --- Same random string as Convex Dev dashboard env ---
# openssl rand -hex 32
CLERK_CONVEX_WEBHOOK_BRIDGE_SECRET=

# --- Optional locally; required on Vercel after you add a Clerk webhook ---
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Leave empty locally (silent). Set on Vercel when ready ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Vercel build: personal key OK for source maps. Convex Capture needs project phc_ key ---
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.i.posthog.com
