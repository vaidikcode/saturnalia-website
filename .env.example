# Public browser configuration. Configure in Vercel for Preview and Production.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Private build-time configuration. Never prefix these names with VITE_.
# Required for Vercel source-map uploads whenever VITE_POSTHOG_KEY is configured.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.i.posthog.com
